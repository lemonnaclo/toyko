new file mode 100644
index 0000000..18e998e
--- /dev/null
+++ b/sheets.js
@@ -0,0 +1,54 @@
+(function (root) {
+  'use strict';
+  const columns = ['date','title','description','route','id','time','name','tag','detail','place','transfer'];
+  function parseCSV(text) {
+    const rows = []; let row = [], field = '', quoted = false;
+    text = text.replace(/^\uFEFF/, '');
+    for (let i = 0; i < text.length; i++) {
+      const c = text[i];
+      if (c === '"') {
+        if (quoted && text[i + 1] === '"') { field += '"'; i++; }
+        else if (quoted || !field) quoted = !quoted;
+        else throw Error('CSV 따옴표 형식을 확인하세요.');
+      } else if (c === ',' && !quoted) { row.push(field); field = ''; }
+      else if ((c === '\n' || c === '\r') && !quoted) {
+        if (c === '\r' && text[i + 1] === '\n') i++;
+        row.push(field); rows.push(row); row = []; field = '';
+      } else field += c;
+    }
+    if (quoted) throw Error('CSV 따옴표가 닫히지 않았습니다.');
+    row.push(field); rows.push(row);
+    return rows.filter(r => r.some(v => v.trim()));
+  }
+  function parse(text) {
+    const rows = parseCSV(text), header = rows.shift()?.map(s => s.trim());
+    if (!header || columns.some(c => !header.includes(c)) || new Set(header).size !== header.length)
+      throw Error('시트의 필수 열 이름을 확인하세요.');
+    const days = new Map(), ids = new Set();
+    for (const [index, row] of rows.entries()) {
+      if (row.length !== header.length) throw Error(`${index + 2}행의 열 개수를 확인하세요.`);
+      const r = Object.fromEntries(header.map((key, i) => [key, row[i].trim()]));
+      if (!/^\d{4}-\d{2}-\d{2}$/.test(r.date) || !/^([01]\d|2[0-3]):[0-5]\d$/.test(r.time) ||
+          !/^[a-zA-Z0-9_-]{1,80}$/.test(r.id) || ids.has(r.id) || !r.name || !r.place || !r.title)
+        throw Error(`${index + 2}행의 날짜·시간·고유 id·필수 값을 확인하세요.`);
+      const date = new Date(r.date + 'T00:00:00Z');
+      if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0,10) !== r.date) throw Error('유효하지 않은 날짜입니다.');
+      ids.add(r.id);
+      if (!days.has(r.date)) days.set(r.date, {id:r.date, date:r.date.slice(5).replace('-','.'), dow:'일월화수목금토'[date.getUTCDay()], title:r.title, desc:r.description, route:r.route.split('|').map(s=>s.trim()).filter(Boolean), stops:[]});
+      const day = days.get(r.date);
+      if (day.title !== r.title || day.desc !== r.description || day.route.join('|') !== r.route.split('|').map(s=>s.trim()).filter(Boolean).join('|')) throw Error('같은 날짜의 제목·설명·동선을 동일하게 입력하세요.');
+      day.stops.push([r.time,r.name,r.tag,r.detail,r.place,r.transfer,r.id]);
+    }
+    if (!days.size || rows.length > 1000) throw Error('일정은 1~1000행이어야 합니다.');
+    return [...days.values()].sort((a,b)=>a.id.localeCompare(b.id)).map(d=>({...d,stops:d.stops.sort((a,b)=>a[0].localeCompare(b[0]))}));
+  }
+  function csvURL(value) {
+    const url = new URL(value);
+    if (url.protocol !== 'https:' || url.hostname !== 'docs.google.com' || !/^\/spreadsheets\/d\/e\/[\w-]+\/pub$/.test(url.pathname) || url.searchParams.get('output') !== 'csv')
+      throw Error('Google Sheets의 게시된 CSV 주소를 설정하세요.');
+    return url;
+  }
+  const api = {parseCSV, parse, csvURL};
+  if (typeof module !== 'undefined') module.exports = api;
+  else root.TokyoSheets = api;
+})(typeof window === 'undefined' ? globalThis : window);
diff --git a/sheets.test.cjs b/sheets.test.cjs
new file mode 100644
index 0000000..91445b6
--- /dev/null
+++ b/sheets.test.cjs
@@ -0,0 +1,26 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const {parse,parseCSV,csvURL}=require('./sheets.js');
+const template=fs.readFileSync('schedule-template.csv','utf8');
+test('original itinerary imports with all stops, stable ids and ordering',()=>{
+  const days=parse(template);
+  assert.equal(days.length,5); assert.equal(days[0].stops.length,5);
+  assert.equal(days[4].stops.length,4); assert.equal(days[0].dow,'목');
+  assert.equal(days[0].stops[0][0],'09:50');
+});
+test('quoted commas, newlines, escaped quotes and BOM',()=>{
+  assert.deepEqual(parseCSV('\uFEFFa,b\r\n"one, two","line\n""quoted"""'),[['a','b'],['one, two','line\n"quoted"']]);
+  assert.throws(()=>parseCSV('"unclosed'));
+});
+test('reject malformed or ambiguous schedules',()=>{
+  assert.throws(()=>parse('date,name\n2026-11-26,test'));
+  assert.throws(()=>parse(template.replace('2026-11-26','2026-02-30')));
+  assert.throws(()=>parse(template.replace('09:50','25:50')));
+  const lines=template.trimEnd().split('\n');
+  assert.throws(()=>parse(template+lines[1]+'\n'));
+});
+test('accept only published Google CSV sources',()=>{
+  assert.equal(csvURL('https://docs.google.com/spreadsheets/d/e/2PACX-test/pub?gid=0&output=csv').hostname,'docs.google.com');
+  for(const url of ['javascript:alert(1)','https://evil.test/pub?output=csv','https://docs.google.com/spreadsheets/d/private/edit'])assert.throws(()=>csvURL(url));
+});
